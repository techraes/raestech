# ============================================================
# RAES TECH — Environment variables
# Copy to .env.local (development) or set in Vercel (production).
# NEVER commit real values. .env.* is gitignored.
# ============================================================

# Supabase (required for a live backend; leave blank to run the
# bundled developer build with local demo auth + seeded catalogue)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Example:
# VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key

# Only the ANON (public) key goes in the frontend.
# The service-role key must NEVER be used in the client.
# It is used only in Edge Functions / server-side code (kept in
# Vercel environment variables, not committed).

# ============================================================
# Development-only local admin override (vite dev ONLY).
# These are read only when import.meta.env.DEV is true and Supabase
# is NOT configured. They are never part of production builds and are
# never used once Supabase is configured. Do not rely on these in prod.
# ============================================================
VITE_DEV_ADMIN_EMAIL=tech.raes@gmail.com
VITE_DEV_ADMIN_PASSWORD=***

# ============================================================
# Supabase Edge Function (create-admin) provisioning secret.
# Server-side only. Used to secure the create-admin function when you
# provision the admin Auth user. Keep in Vercel/supabase secrets, never
# in the client.
# ============================================================
# ADMIN_SEED_SECRET=change-me-strong-secret

# ============================================================
# Resend (transactional email) - server-side ONLY.
# Used by the send-email Supabase Edge Function. Never expose the
# RESEND_API_KEY to the browser.
# ============================================================
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
# RESEND_FROM=RAES TECH <onboarding@resend.dev>
# SEND_EMAIL_SECRET=***
#
# Optional anti-abuse tuning for the send-email function (daily caps).
# Defaults in brackets.
# SEND_MAX_PER_IP_PER_DAY=50
# SEND_MAX_PER_RECIPIENT_PER_DAY=5
# SEND_MAX_GLOBAL_PER_DAY=1000

